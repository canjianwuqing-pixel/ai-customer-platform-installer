# Public hostname for the Chatwoot installation.
# Example format only: chat.example.com
DOMAIN=

# Email address used by Chatwoot for operational messages.
EMAIL=

# Email address registered with Let's Encrypt for certificate notifications.
LETSENCRYPT_EMAIL=

# Secrets must be generated per installation and must never be committed.
DATABASE_PASSWORD=
REDIS_PASSWORD=
SECRET_KEY_BASE=

# Chatwoot stack configuration. Image tags are exact versions; do not use latest.
CHATWOOT_VERSION=v4.18.0
POSTGRES_VERSION=0.8.7-pg16
REDIS_VERSION=7.4.11-alpine

# Database names and internal Docker DNS names are configurable.
DATABASE_NAME=chatwoot
DATABASE_USER=postgres
DATABASE_HOST=postgres
REDIS_HOST=redis

# Rails remains bound locally and is exposed only through Nginx.
CHATWOOT_BIND_ADDRESS=127.0.0.1
CHATWOOT_HTTP_PORT=3000
CHATWOOT_HTTP_CHECK_URL=http://localhost:3000

# Compose project and readiness settings.
CHATWOOT_COMPOSE_PROJECT=ai-customer-platform
CHATWOOT_DEPENDENCY_TIMEOUT_SECONDS=120
CHATWOOT_HEALTHCHECK_INTERVAL_SECONDS=5
CHATWOOT_HTTP_TIMEOUT_SECONDS=15

# AI Service images must include a fixed tag or sha256 digest. The installer
# does not assume or publish application images.
AI_SERVICE_IMAGE=
AI_ADMIN_IMAGE=

# OpenAI and model configuration. Never commit a populated API key.
OPENAI_API_KEY=
AI_MODEL=

# FastAPI-to-admin authentication and the initial management account.
AI_SERVICE_INTERNAL_TOKEN=
AI_ADMIN_USERNAME=
AI_ADMIN_PASSWORD=
AI_ADMIN_SESSION_SECRET=

# Optional hostname passed to the AI application. V1 does not create another
# Nginx virtual host because multi-domain routing is not implemented yet.
AI_SERVICE_DOMAIN=

# Both services bind to loopback by default. Container ports must match the
# ports exposed by the selected application images.
AI_SERVICE_BIND_ADDRESS=127.0.0.1
AI_SERVICE_HTTP_PORT=8000
AI_SERVICE_CONTAINER_PORT=8000
AI_ADMIN_BIND_ADDRESS=127.0.0.1
AI_ADMIN_HTTP_PORT=8080
AI_ADMIN_CONTAINER_PORT=8080
AI_SERVICE_HTTP_CHECK_URL=http://localhost:8000/health
AI_ADMIN_HTTP_CHECK_URL=http://localhost:8080/health

# Persistent data locations inside the selected images.
AI_SERVICE_DATA_PATH=/app/data
AI_ADMIN_DATA_PATH=/app/data

# Compose lifecycle and safe logging defaults.
AI_SERVICE_COMPOSE_PROJECT=ai-customer-platform-ai
AI_SERVICE_STARTUP_TIMEOUT_SECONDS=120
AI_SERVICE_HEALTHCHECK_INTERVAL_SECONDS=5
AI_SERVICE_HTTP_TIMEOUT_SECONDS=15
AI_LOG_LEVEL=INFO
AI_LOG_SENSITIVE_DATA=false
AI_LOG_MAX_SIZE=10m
AI_LOG_MAX_FILES=3

# Optional Chatwoot integration reservation. Leave all three empty until the
# Chatwoot webhook and inbox are configured. If one is set, all are required.
CHATWOOT_WEBHOOK_URL=
CHATWOOT_WEBHOOK_SECRET=
CHATWOOT_INBOX_ID=

# Nginx reverse-proxy configuration.
NGINX_LISTEN_PORT=80
NGINX_UPSTREAM_HOST=127.0.0.1
NGINX_SITE_NAME=ai-customer-platform-chatwoot
NGINX_CLIENT_MAX_BODY_SIZE=40m
NGINX_PROXY_READ_TIMEOUT_SECONDS=3600

# Domain and certificate management. V1 supports one domain with the
# Let's Encrypt HTTP-01 challenge. Keep port 80 publicly reachable.
DOMAIN_CERTIFICATE_PROVIDER=letsencrypt
DOMAIN_CHALLENGE_TYPE=http-01
DOMAIN_DNS_CHECK=true
DOMAIN_HTTPS_PORT=443
CERTBOT_RENEW_DRY_RUN=true
CERTBOT_RENEWAL_TIMER=certbot.timer

# Docker official APT repository configuration.
DOCKER_APT_REPOSITORY_URL=https://download.docker.com/linux/ubuntu
DOCKER_GPG_KEY_URL=https://download.docker.com/linux/ubuntu/gpg
DOCKER_APT_CHANNEL=stable

# Optional exact APT version shared by docker-ce and docker-ce-cli.
# Leave empty to install the latest stable packages from the official repository.
DOCKER_VERSION=

# Local backup policy. The directory must be absolute and is created with
# mode 0700. Every retained backup contains secrets and must be protected.
BACKUP_DIR=/var/backups/ai-customer-platform
BACKUP_RETENTION=7
BACKUP_COMPRESS=true

# Fixed utility image and configurable Compose service contracts used by the
# backup module. Service names must match the selected Compose files.
BACKUP_TOOL_IMAGE=alpine:3.22.6
BACKUP_CHATWOOT_DATABASE_SERVICE=postgres
BACKUP_CHATWOOT_STORAGE_SERVICE=rails
BACKUP_CHATWOOT_APP_SERVICES="rails sidekiq"
BACKUP_CHATWOOT_REQUIRED_SERVICES="postgres redis rails sidekiq"
BACKUP_AI_DATA_SERVICE=ai-service
BACKUP_AI_ADMIN_SERVICE=ai-admin
BACKUP_AI_APP_SERVICES="ai-service ai-admin"
BACKUP_AI_REQUIRED_SERVICES="ai-service ai-admin"
BACKUP_CHATWOOT_STORAGE_PATH=/app/storage
