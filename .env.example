# Public hostname for the Chatwoot installation.
# Example format only: chat.example.com
DOMAIN=

# Email address used for operational notifications and future SSL setup.
EMAIL=

# Secrets must be generated per installation and must never be committed.
DATABASE_PASSWORD=
REDIS_PASSWORD=
SECRET_KEY_BASE=

# Pin a tested Chatwoot release before running a future installer version.
CHATWOOT_VERSION=
