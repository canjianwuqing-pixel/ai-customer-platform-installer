# 普通安装只需要网站域名和管理员邮箱。留空时，install.sh 会交互询问。
DOMAIN=
EMAIL=

# 留空时自动复用 EMAIL。
LETSENCRYPT_EMAIL=

# 以下 Secret 无需手动填写。安装器会在首次运行时安全生成，并在重复
# 执行时保留原值。禁止将生成后的 .env 提交到 Git。
DATABASE_PASSWORD=
REDIS_PASSWORD=
SECRET_KEY_BASE=
AI_SERVICE_INTERNAL_TOKEN=
# 统一后台只使用下列一套账号；开启后迁移并清空旧 AI_ADMIN_* 凭据。
ADMIN_ENABLED=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
ADMIN_MAINTENANCE_TOKEN=
# 管理 API 专用 Token，独立于聊天 Token；自动生成，禁止提交真实值。
SERVICE_MANAGEMENT_TOKEN=

# AI Service 默认不安装。高级用户可填写两个固定版本镜像启用它；
# 不允许使用 latest。OpenAI API Key 和模型在管理后台中另行配置。
AI_SERVICE_IMAGE=
AI_ADMIN_IMAGE=

# 可选：使用仓库内的多实例 Runtime 时，设置固定版本 AI_SERVICE_IMAGE
# 作为本地构建标签，并开启 AI_RUNTIME_BUILD；仍需配置 AI_ADMIN_IMAGE。
AI_RUNTIME_BUILD=false
# 多个实例启用时，指定省略 service_id 的请求使用哪个实例。
AI_DEFAULT_SERVICE_ID=
# 高级：共享凭据仍保存在本地 .env；不同实例可通过 .env.ai-runtime
# 注入不同环境变量，再由 ai_config 的 api_key_env 引用。
OPENAI_API_KEY=
