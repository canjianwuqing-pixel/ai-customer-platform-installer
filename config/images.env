# Official pinned image versions used by a standard installation.
# Moving tags such as "latest" are intentionally forbidden.
CHATWOOT_VERSION=v4.18.0
POSTGRES_VERSION=0.8.7-pg16
REDIS_VERSION=7.4.11-alpine

# AI Service is optional. Advanced users can enable it by setting both images
# to fixed tags or digests in .env. No vendor image is assumed by default.
AI_SERVICE_IMAGE=
AI_ADMIN_IMAGE=

# Base image used only when AI_RUNTIME_BUILD=true.
AI_RUNTIME_PYTHON_IMAGE=python:3.12.12-slim-bookworm
ADMIN_PYTHON_IMAGE=python:3.12.12-slim-bookworm
ADMIN_DEFAULT_IMAGE=ai-customer-platform-admin:1.0.0
ADMIN_RUNTIME_IMAGE=ai-customer-platform-runtime:1.0.0
