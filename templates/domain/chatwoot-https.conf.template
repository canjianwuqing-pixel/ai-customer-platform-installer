# Managed by AI Customer Platform Installer.
# Managed by AI Customer Platform Installer domain module.
# Managed Chatwoot API header policy (http context).
# Default virtual hosts inherit this when Host has not yet been parsed (also
# without matching SNI). No default_server takeover or invalid-header bypass.
underscores_in_headers on;

server {
    listen {{NGINX_LISTEN_PORT}};
    listen [::]:{{NGINX_LISTEN_PORT}};
    server_name {{DOMAIN}};
    underscores_in_headers on;

    location ^~ /.well-known/acme-challenge/ {
        root {{WEBSITE_CERTBOT_WEBROOT}};
        default_type text/plain;
        try_files $uri =404;
    }
    location / { return 301 https://$host{{HTTPS_PORT_SUFFIX}}$request_uri; }
}

server {
    listen {{DOMAIN_HTTPS_PORT}} ssl;
    listen [::]:{{DOMAIN_HTTPS_PORT}} ssl;
    server_name {{DOMAIN}};
    underscores_in_headers on;

    ssl_certificate {{CERTBOT_FULLCHAIN_PATH}};
    ssl_certificate_key {{CERTBOT_PRIVATE_KEY_PATH}};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    client_max_body_size {{NGINX_CLIENT_MAX_BODY_SIZE}};
    # PLATFORM_DOMAIN_CHECK_LOCATION
    # PLATFORM_ADMIN_LOCATION

    location / {
        proxy_pass http://{{NGINX_UPSTREAM_HOST}}:{{CHATWOOT_HTTP_PORT}};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
    }

    location /cable {
        proxy_pass http://{{NGINX_UPSTREAM_HOST}}:{{CHATWOOT_HTTP_PORT}};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout {{NGINX_PROXY_READ_TIMEOUT_SECONDS}}s;
        proxy_send_timeout {{NGINX_PROXY_READ_TIMEOUT_SECONDS}}s;
        proxy_redirect off;
    }
}
