    location = /admin {
        if ($scheme = http) { return 301 https://$host{{HTTPS_PORT_SUFFIX}}$request_uri; }
        proxy_pass http://{{ADMIN_UPSTREAM_HOST}}:{{AI_ADMIN_HTTP_PORT}};
        # Preserve the browser authority, including non-default HTTPS ports.
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_redirect off;
    }
    location ^~ /admin/ {
        if ($scheme = http) { return 301 https://$host{{HTTPS_PORT_SUFFIX}}$request_uri; }
        proxy_pass http://{{ADMIN_UPSTREAM_HOST}}:{{AI_ADMIN_HTTP_PORT}};
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_redirect off;
    }
