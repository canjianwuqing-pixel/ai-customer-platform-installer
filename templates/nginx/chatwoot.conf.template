# Managed by AI Customer Platform Installer.
# Managed Chatwoot API header policy (http context).
# This file is included inside http {}. Default virtual hosts must inherit this
# before Host is parsed; a server-only setting loses headers arriving earlier.
underscores_in_headers on;

server {
    listen {{NGINX_LISTEN_PORT}};
    listen [::]:{{NGINX_LISTEN_PORT}};
    server_name {{DOMAIN}};
    underscores_in_headers on;

    client_max_body_size {{NGINX_CLIENT_MAX_BODY_SIZE}};
    # PLATFORM_ADMIN_LOCATION

    location / {
        proxy_pass http://{{NGINX_UPSTREAM_HOST}}:{{CHATWOOT_HTTP_PORT}};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
    }

    location /cable {
        proxy_pass http://{{NGINX_UPSTREAM_HOST}}:{{CHATWOOT_HTTP_PORT}};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout {{NGINX_PROXY_READ_TIMEOUT_SECONDS}}s;
        proxy_send_timeout {{NGINX_PROXY_READ_TIMEOUT_SECONDS}}s;
        proxy_redirect off;
    }
}
