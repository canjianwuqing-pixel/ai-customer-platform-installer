# Allow-list the runtime source; .env, Git, local profiles, and backups are
# never sent to the Docker builder.
**
!ai_runtime/
!ai_runtime/*.py
!ai_runtime/requirements.txt
!stacks/
!stacks/ai-service/
!stacks/ai-service/Dockerfile.runtime
!platform_admin/
!platform_admin/*.py
!platform_admin/requirements.txt
!platform_admin/templates/
!platform_admin/templates/*.html
!platform_admin/static/
!platform_admin/static/*.js
!stacks/admin/
!stacks/admin/Dockerfile
