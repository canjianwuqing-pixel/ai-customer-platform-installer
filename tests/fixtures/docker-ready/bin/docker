#!/usr/bin/env bash
set -Eeuo pipefail

if [[ -n "${DOCKER_FIXTURE_LOG:-}" ]]; then
  printf '%s\n' "$*" >>"${DOCKER_FIXTURE_LOG}"
fi

if [[ -n "${DOCKER_FIXTURE_FAIL_MATCH:-}" ]] &&
  [[ "$*" == *"${DOCKER_FIXTURE_FAIL_MATCH}"* ]]; then
  printf 'Fixture Docker failure for command containing: %s\n' \
    "${DOCKER_FIXTURE_FAIL_MATCH}" >&2
  exit 1
fi
if [[ "${CURL_FIXTURE_FAIL_READY:-false}" == true && "$*" == *'exec -T ai-admin python -c'* ]]; then exit 1; fi

case "${1:-}" in
  --version)
    printf '%s\n' 'Docker version 29.0.0, build fixture'
    ;;
  compose)
    shift
    compose_arguments="$*"

    if [[ "${1:-}" == "version" ]]; then
      if [[ "${2:-}" == --short ]]; then printf '%s\n' "${DOCKER_FIXTURE_COMPOSE_VERSION:-5.0.0}"; else printf '%s\n' 'Docker Compose version v5.0.0-fixture'; fi
      exit 0
    fi

    while (($# > 0)); do
      case "$1" in
        --project-name | --env-file | --file)
          shift 2
          ;;
        *)
          break
          ;;
      esac
    done

    case "${1:-}" in
      ps)
        if [[ "$*" == *"--quiet"* ]]; then
          service_name="${!#}"
          printf 'fixture-container-%s\n' "${service_name}"
        elif [[ "${compose_arguments}" == *"ai-customer-platform-ai-test"* ]]; then
          for service_name in ai-service ai-admin; do
            [[ "${service_name}" == "${DOCKER_FIXTURE_MISSING_SERVICE:-}" ]] ||
              printf '%s\n' "${service_name}"
          done
        else
          for service_name in postgres redis rails sidekiq; do
            [[ "${service_name}" == "${DOCKER_FIXTURE_MISSING_SERVICE:-}" ]] ||
              printf '%s\n' "${service_name}"
          done
        fi
        ;;
      exec)
        if [[ "$*" == *" pg_dump "* ]]; then
          printf '%s\n' 'fixture-postgresql-custom-dump'
        fi
        ;;
      logs)
        printf 'fixture logs for %s\n' "${compose_arguments}"
        ;;
      config | pull | build | up | run | start | stop | restart | create)
        ;;
      *)
        printf 'Unexpected fixture Docker Compose command: %s\n' "${1:-missing}" >&2
        exit 1
        ;;
    esac
    ;;
  run)
    # Optional real volume transport for persistence fixtures. Only this exact,
    # resolved disposable directory can be archived/restored; never a host path
    # supplied by the production command being simulated.
    if [[ -n "${DOCKER_FIXTURE_AI_DATA_DIR:-}" &&
          ( "$*" == *'--volumes-from fixture-container-ai-service:ro '* ||
            "$*" == *'--volumes-from fixture-container-ai-service '* ) ]]; then
      fixture_volume="$(cd -- "${DOCKER_FIXTURE_AI_DATA_DIR}" && pwd -P)"
      fixture_owner="$(cd -- "${ADMIN_INSTALLER_FIXTURE_ROOT:?}" && pwd -P)"
      [[ "${fixture_volume}" == "${fixture_owner}/runtime-data" ]] || exit 1
      case "${fixture_owner}" in */runtime/tests/admin-installer.*) ;; *) exit 1 ;; esac
      if [[ "$*" == *' -czf - .'* ]]; then tar -C "${fixture_volume}" -czf - .
      elif [[ "$*" == *' -cf - .'* ]]; then tar -C "${fixture_volume}" -cf - .
      else
        find "${fixture_volume}" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +
        if [[ "${!#}" == true ]]; then tar -C "${fixture_volume}" -xzf -
        else tar -C "${fixture_volume}" -xf -; fi
      fi
      exit 0
    fi
    if [[ "$*" == *" -czf - ."* ]]; then
      tar -czf - --files-from /dev/null
    elif [[ "$*" == *" -cf - ."* ]]; then
      tar -cf - --files-from /dev/null
    fi
    ;;
  info | version)
    printf '%s\n' 'Docker daemon fixture'
    ;;
  volume)
    [[ "${DOCKER_FIXTURE_CHATWOOT_DEPLOYED:-false}" != true ]] || printf '%s\n' 'fixture-existing-postgres-volume'
    ;;
  stop | start)
    ;;
  ps)
    if [[ "$*" == *service=rails* ]]; then printf '%s\n' fixture-rails
    elif [[ "$*" == *service=postgres* ]]; then printf '%s\n' fixture-postgres
    elif [[ "$*" == *service=redis* ]]; then printf '%s\n' fixture-redis
    elif [[ -n "${AI_SERVICE_IMAGE:-}" && "${DOCKER_FIXTURE_AI_DEPLOYED:-true}" == true ]]; then
      if [[ "$*" == *service=ai-admin* ]]; then printf '%s\n' fixture-ai-admin; else printf '%s\n' fixture-ai-service; fi
    fi
    ;;
  inspect)
    if [[ "$*" == *config_files* ]]; then
      printf '%s' 'compose.yaml'
      [[ "${ADMIN_ENABLED:-false}" != true ]] || printf '%s' ',stacks/admin/compose.yaml'
      [[ "${AI_RUNTIME_BUILD:-false}" != true ]] || printf '%s' ',compose.runtime.yaml'
      printf '\n'
    elif [[ "$*" == *'.Config.Env'* ]]; then
      printf 'POSTGRES_PASSWORD=%s\nREDIS_PASSWORD=%s\nSECRET_KEY_BASE=%s\n' "${DOCKER_FIXTURE_DATABASE_PASSWORD:-${DATABASE_PASSWORD:-}}" "${REDIS_PASSWORD:-}" "${SECRET_KEY_BASE:-}"
    elif [[ "$*" == *'.Config.Image'* ]]; then
      case "${!#}" in
        fixture-rails) printf 'chatwoot/chatwoot:%s\n' "${CHATWOOT_VERSION}" ;;
        fixture-postgres) printf 'pgvector/pgvector:%s\n' "${POSTGRES_VERSION}" ;;
        fixture-redis) printf 'redis:%s\n' "${REDIS_VERSION}" ;;
        fixture-ai-admin) printf '%s\n' "${AI_ADMIN_IMAGE}" ;;
        *) printf '%s\n' "${AI_SERVICE_IMAGE}" ;;
      esac
    fi
    ;;
  *)
    printf 'Unexpected fixture Docker command: %s\n' "${1:-missing}" >&2
    exit 1
    ;;
esac
