#!/usr/bin/env bash
set -Eeuo pipefail

if [[ -n "${NGINX_FIXTURE_LOG:-}" ]]; then
  printf 'nginx %s\n' "$*" >>"${NGINX_FIXTURE_LOG}"
fi

case "${1:-}" in
  -v)
    printf '%s\n' 'nginx version: nginx/1.24.0-fixture' >&2
    ;;
  -t)
    if [[ "${NGINX_FIXTURE_TEST_FAILURE:-false}" == "true" ]]; then
      printf '%s\n' 'nginx: fixture configuration test failed' >&2
      exit 1
    fi
    if [[ "${NGINX_FIXTURE_HTTPS_FAILURE:-false}" == "true" ]] &&
      grep -Rqs -- 'listen 443 ssl;' "${NGINX_CONFIG_ROOT:-/etc/nginx}/sites-available"; then
      printf '%s\n' 'nginx: fixture HTTPS configuration test failed' >&2
      exit 1
    fi
    printf '%s\n' 'nginx: fixture configuration test is successful' >&2
    ;;
  *)
    printf 'Unexpected fixture Nginx command: %s\n' "${1:-missing}" >&2
    exit 1
    ;;
esac
