AI_SERVICE_HTTP_TIMEOUT_SECONDS=2
AI_LOG_LEVEL=INFO
AI_LOG_SENSITIVE_DATA=false
AI_LOG_MAX_SIZE=10m
AI_LOG_MAX_FILES=3
CHATWOOT_WEBHOOK_URL=
