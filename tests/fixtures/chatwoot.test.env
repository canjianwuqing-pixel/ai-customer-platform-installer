DOMAIN=chatwoot.example.test
EMAIL=operations@example.test
LETSENCRYPT_EMAIL=certificates@example.test
DATABASE_PASSWORD=fixture_database_password
REDIS_PASSWORD=fixture_redis_password
SECRET_KEY_BASE=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
CHATWOOT_VERSION=v4.18.0
POSTGRES_VERSION=0.8.7-pg16
REDIS_VERSION=7.4.11-alpine
DATABASE_NAME=chatwoot
DATABASE_USER=postgres
DATABASE_HOST=postgres
REDIS_HOST=redis
CHATWOOT_BIND_ADDRESS=127.0.0.1
CHATWOOT_HTTP_PORT=3000
CHATWOOT_HTTP_CHECK_URL=http://localhost:3000
CHATWOOT_COMPOSE_PROJECT=ai-customer-platform-test
CHATWOOT_DEPENDENCY_TIMEOUT_SECONDS=10
CHATWOOT_HEALTHCHECK_INTERVAL_SECONDS=1
CHATWOOT_HTTP_TIMEOUT_SECONDS=2
NGINX_LISTEN_PORT=80
NGINX_UPSTREAM_HOST=127.0.0.1
NGINX_SITE_NAME=ai-customer-platform-chatwoot
