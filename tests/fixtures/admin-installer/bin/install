#!/usr/bin/env bash
set -Eeuo pipefail

# Emulate Admin/Nginx/renew-hook installation without touching the host.
# Every actual write must stay in the fixture's explicitly configured root.
fixture_install_target() {
  local target="$1" resolved
  resolved="$(readlink -m -- "${target}")"
  case "${resolved}" in
    "${ADMIN_INSTALLER_FIXTURE_ROOT}"/*) printf '%s\n' "${resolved}" ;;
    *) printf '%s\n' 'Refusing an install write outside the fixture.' >&2; return 1 ;;
  esac
}

if [[ "${1:-}" == -d && "${2:-}" == -m && ("${3:-}" == 0700 || "${3:-}" == 0755) && $# -ge 4 ]]; then
  fixture_mode="$3"
  shift 3
  for target in "$@"; do
    target="$(fixture_install_target "${target}")"
    mkdir -p -- "${target}"
    chmod "${fixture_mode}" "${target}"
  done
elif [[ "${1:-}" == -m && ("${2:-}" == 0644 || "${2:-}" == 0755) && $# == 4 ]]; then
  if [[ "$4" == /etc/systemd/system/ai-customer-platform-maintenance-fixture.service ]]; then
    target="$(fixture_install_target "${ADMIN_INSTALLER_FIXTURE_ROOT}/maintenance.service")"
  else
    target="$(fixture_install_target "$4")"
  fi
  cp -- "$3" "${target}"
  chmod "$2" "${target}"
else
  printf '%s\n' 'Unexpected fixture install arguments.' >&2
  exit 1
fi
